{
	"name": "chingu-voyage-v63",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10.24.0 <11"
	},
	"scripts": {
		"preinstall": "npx --yes only-allow pnpm",
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r typecheck",
		"db:types": "pnpm --filter @event-planner/db-types gen",
		"test": "pnpm -r test",
		"deploy:cloudflare": "pnpm --filter @event-planner/web build && pnpm --filter @event-planner/server exec wrangler deploy",
		"prepare": "[ -n \"$CI\" ] || lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2"
	}
}
