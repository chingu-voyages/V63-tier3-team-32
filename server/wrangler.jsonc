{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-planner-server",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-19",
	"workers_dev": true,
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	}
}
