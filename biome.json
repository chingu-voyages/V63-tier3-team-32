{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"!**/node_modules",
			"!**/dist",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"linter": { "enabled": true, "rules": { "preset": "none" } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
